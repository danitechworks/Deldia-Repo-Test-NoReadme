# Example values only; copy locally if needed.
APP_NAME="DelDia Preview Sample"
APP_ENV=example
APP_ENABLED=true
APP_PORT=8080

# Loopback addresses and placeholder labels.
BASE_URL="http://localhost:8080"
LOG_LEVEL=debug
PREVIEW_MAX_LINES=250
